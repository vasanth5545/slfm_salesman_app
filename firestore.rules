rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is accessing their own data
    function isOwner(data) {
      return request.auth != null && data.salesman_id == request.auth.uid;
    }

    // 🔥 App Settings — allows reading ALL documents (maintenance_mode, maintenance_message, status_color, etc.)
    match /app_settings/{document} {
      allow read: if true; // Allow public read for maintenance check
      allow write: if false; // 🔒 SECURED: Only admins (via backend/Firebase Admin SDK) can write
    }

    // 🔥 Feature Control — allows reading walking_customer, damage_report flags
    match /feature_control/{document} {
      allow read: if request.auth != null;
      allow write: if false; // Only admins can write
    }

    match /holidays/{document} {
      allow read: if request.auth != null;
    }

    match /salesman_monthly_performance/{document} {
      allow read: if request.auth != null;
    }

    match /salesmen/{document} {
      // Only allow reading their own salesman document
      allow read: if request.auth != null && request.auth.uid == document;
    }

    match /attendance/{document} {
      // Allow get for non-existent docs without crashing, else verify owner
      allow get: if request.auth != null && (resource == null || request.auth.uid == resource.data.salesman_id);
      // Allow list and update/delete only if auth matches existing document's salesman_id
      allow list, update, delete: if request.auth != null && request.auth.uid == resource.data.salesman_id;
      // Allow create if auth matches the new document's salesman_id
      allow create: if request.auth != null && request.auth.uid == request.resource.data.salesman_id;
    }
    
    match /performance_summary/{document} {
      // Allow get for non-existent docs (returns null gracefully instead of PERMISSION_DENIED)
      allow get: if request.auth != null && (resource == null || resource.data.salesman_id == request.auth.uid);
      allow list: if request.auth != null && resource.data.salesman_id == request.auth.uid;
      allow create: if isOwner(request.resource.data);
      allow update, delete: if isOwner(resource.data) && isOwner(request.resource.data);
    }
    
    match /leave_requests/{document} {
      allow get: if request.auth != null && (resource == null || isOwner(resource.data));
      allow list: if request.auth != null && isOwner(resource.data);
      allow create: if isOwner(request.resource.data);
      allow update, delete: if isOwner(resource.data) && isOwner(request.resource.data);
    }
    
    match /leave_cancel_requests/{document} {
      allow read: if isOwner(resource.data);
      allow create: if isOwner(request.resource.data);
      allow update, delete: if isOwner(resource.data) && isOwner(request.resource.data);
    }
    
    match /users/{userId} {
      // Allow user to read their own user document
      allow read: if request.auth != null && userId == request.auth.uid;
      allow write: if false;
    }

    // Block all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
